# ==========================================================================
# PhishScope Backend - environment template
# انسخ الملف ده لـ .env واملأ القيم. ممنوع رفع .env على Git أبداً.
# ==========================================================================

# Database (لو شغال بـ docker-compose سيبها زي ما هي)
DB_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg2://phishscope:change-me-locally@localhost:5432/phishscope
# للتطوير السريع من غير Docker: sqlite:///./phishscope.db

# Auth
JWT_SECRET=generate-a-long-random-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Threat Intelligence providers (كلها مفاتيح مجانية - سيبها فاضية والـ provider هيتخطى)
VIRUSTOTAL_API_KEY=          # 500 req/day, 4 req/min - virustotal.com
URLSCAN_API_KEY=             # free tier - urlscan.io
PHISHTANK_APP_KEY=           # free - phishtank.com developer info
URLHAUS_AUTH_KEY=            # free - abuse.ch auth portal
SAFE_BROWSING_API_KEY=       # free quota - Google Cloud console

# Provider behavior
HTTP_TIMEOUT_SECONDS=4
TI_CACHE_TTL_HOURS=24
ANALYSIS_DEDUP_HOURS=24

# n8n automation (webhook محمي بـ secret header)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/phishscope-alert
N8N_WEBHOOK_SECRET=generate-another-long-random-string

# Rate limiting
RATE_LIMIT_ANALYZE=30/minute
